# ---------------------------------------------------------------------------
# fba-variations — environment configuration
# Copy this to ".env" on the server and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Web app login (gates the whole UI) ---
APP_USER=admin
# Set a FRESH password here directly on the server. Do not reuse one sent over chat/email.
APP_PASS=change-me-on-deploy

# --- SP-API credentials (same values as the amazon-seller app) ---
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=
LWA_REFRESH_TOKEN=
SELLER_ID=
# SP_API_SELLER_ID is used if set, otherwise SELLER_ID is used.
# SP_API_SELLER_ID=

# --- Marketplace / region (defaults shown; US + North America) ---
MARKETPLACE_ID=ATVPDKIKX0DER
REGION_HOST=https://sellingpartnerapi-na.amazon.com

# --- Server ---
PORT=3008
